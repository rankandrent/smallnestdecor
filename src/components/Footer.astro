---
import { categories } from '../data/categories';
import { siteConfig } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-sand bg-beige/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-2xl font-semibold">
        Small<span class="text-terracotta">Nest</span>Decor
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-cocoa">
        {siteConfig.tagline} Decor, paint colors and storage ideas made
        specifically for apartments and first small homes — new ideas every week.
      </p>
      <form class="mt-5 flex max-w-sm gap-2" aria-label="Newsletter signup (coming soon)">
        <input
          type="email"
          required
          disabled
          placeholder="Email for the weekly small-space letter — soon"
          class="min-h-11 flex-1 rounded-full border border-sand bg-white/70 px-4 text-sm text-cocoa placeholder:text-cocoa/60"
        />
        <button type="submit" disabled class="min-h-11 cursor-not-allowed rounded-full bg-terracotta/50 px-5 text-sm font-semibold text-white">
          Join
        </button>
      </form>
      <p class="mt-2 text-xs text-cocoa/80">Our newsletter is coming soon — Pinterest is the fastest way to follow along meanwhile.</p>
    </div>

    <nav aria-label="Categories">
      <p class="text-xs font-semibold uppercase tracking-widest text-cocoa">Browse ideas</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {categories.map((c) => (
          <li><a href={`/category/${c.slug}`} class="hover:text-terracotta-dark">{c.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Site">
      <p class="text-xs font-semibold uppercase tracking-widest text-cocoa">SmallNestDecor</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/blog" class="hover:text-terracotta-dark">All ideas</a></li>
        <li><a href="/about" class="hover:text-terracotta-dark">About</a></li>
        <li><a href="/contact" class="hover:text-terracotta-dark">Contact</a></li>
        <li><a href="/affiliate-disclosure" class="hover:text-terracotta-dark">Affiliate Disclosure</a></li>
        <li><a href="/privacy-policy" class="hover:text-terracotta-dark">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-terracotta-dark">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-sand/70 py-5 text-center text-xs text-cocoa">
    © {year} {siteConfig.name}. Made for small spaces everywhere.
  </div>
</footer>
