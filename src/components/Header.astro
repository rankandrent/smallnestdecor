---
import { categories } from '../data/categories';
import { siteConfig } from '../site.config';

const nav = categories.slice(0, 6);
---

<header class="sticky top-0 z-40 border-b border-sand/70 bg-cream/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="SmallNestDecor home">
      <img src="/images/logo.svg" alt="" width="34" height="34" class="h-8.5 w-8.5" />
      <span class="font-display text-xl font-semibold tracking-tight">
        Small<span class="text-terracotta">Nest</span>Decor
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-cocoa lg:flex" aria-label="Categories">
      {nav.map((c) => (
        <a href={`/category/${c.slug}`} class="py-2 transition-colors hover:text-terracotta-dark">{c.shortName}</a>
      ))}
      <a href="/blog" class="py-2 transition-colors hover:text-terracotta-dark">All Ideas</a>
      <a href="/about" class="py-2 transition-colors hover:text-terracotta-dark">About</a>
    </nav>

    <details class="relative lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full border border-sand bg-white/60 text-xl" aria-label="Open menu">
        ☰
      </summary>
      <nav class="absolute right-0 top-13 w-60 rounded-2xl border border-sand bg-white p-3 shadow-xl" aria-label="Mobile categories">
        {categories.map((c) => (
          <a href={`/category/${c.slug}`} class="block rounded-xl px-3 py-2.5 text-sm font-medium hover:bg-beige">{c.name}</a>
        ))}
        <a href="/blog" class="block rounded-xl px-3 py-2.5 text-sm font-medium hover:bg-beige">All Ideas</a>
        <a href="/about" class="block rounded-xl px-3 py-2.5 text-sm font-medium hover:bg-beige">About</a>
        <a href="/contact" class="block rounded-xl px-3 py-2.5 text-sm font-medium hover:bg-beige">Contact</a>
      </nav>
    </details>
  </div>
</header>
