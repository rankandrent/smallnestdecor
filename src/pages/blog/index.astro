---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../data/categories';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="All Ideas" description="Every SmallNestDecor guide: small apartment decor, paint colors, organization and renter-friendly ideas in one place.">
  <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terracotta-dark">The full collection</p>
    <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">All ideas</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-cocoa">
      Every guide we publish, newest first. Use the filters to jump straight
      to a room or a topic, or just wander; small homes reward wandering.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter articles by category">
      <button data-filter="all" class="filter-chip min-h-11 rounded-full bg-charcoal px-5 text-sm font-semibold text-white">All</button>
      {categories.map((c) => (
        <button data-filter={c.slug} class="filter-chip min-h-11 rounded-full border border-sand bg-white px-5 text-sm font-semibold text-cocoa transition-colors hover:border-terracotta hover:text-terracotta-dark">
          {c.shortName}
        </button>
      ))}
    </div>

    <div id="article-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((a) => (
        <ArticleCard slug={a.data.slug} title={a.data.title} description={a.data.description} category={a.data.category} heroImage={a.data.heroImage} date={a.data.date} />
      ))}
    </div>
    <p id="no-results" class="mt-10 hidden text-center text-cocoa">No ideas in this corner yet, new guides land every week.</p>
  </section>

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.filter-chip');
      var cards = document.querySelectorAll('#article-grid [data-category]');
      var empty = document.getElementById('no-results');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var f = chip.getAttribute('data-filter');
          chips.forEach(function (c) {
            c.classList.remove('bg-charcoal', 'text-white');
            c.classList.add('bg-white', 'text-cocoa', 'border', 'border-sand');
          });
          chip.classList.add('bg-charcoal', 'text-white');
          chip.classList.remove('bg-white', 'text-cocoa');
          var visible = 0;
          cards.forEach(function (card) {
            var show = f === 'all' || card.getAttribute('data-category') === f;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          if (empty) empty.classList.toggle('hidden', visible > 0);
        });
      });
    })();
  </script>
</BaseLayout>
